# Copy to .env and fill in. .env is gitignored. With DEBUG off, the app refuses to start unless
# SECRET_KEY, ALLOWED_HOSTS and DATABASE_URL are set properly.

# --- Core -------------------------------------------------------------------
# Production: DEBUG=False. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed behind HTTPS with a domain, e.g. https://health.example.com
CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------
# MySQL, using a dedicated limited user (not root): GRANT ALL ON sajhya_health.* TO 'sajhya_health_user'@'localhost';
DATABASE_URL=mysql://sajhya_health_user:change-me@localhost:3306/sajhya_health
# Keep connections open this many seconds (MySQL only)
DB_CONN_MAX_AGE=60
# `manage.py test` uses in-memory SQLite by default because the app's DB user usually cannot create a test database.
# TEST_DATABASE_URL=

# --- HTTPS / proxy (production) ----------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Set True when a reverse proxy (nginx, cPanel/Passenger, a load balancer) terminates HTTPS and
# forwards X-Forwarded-Proto / X-Forwarded-For.
BEHIND_PROXY=False

# --- Files --------------------------------------------------------------------
# Private credential uploads (IDs, licences, insurance). Keep OUTSIDE the web root and back it up.
PRIVATE_MEDIA_ROOT=
# Serve /media/ (profile and product photos) from Django. True suits cPanel/Passenger; False only if nginx/Apache serves /media/ itself.
SERVE_MEDIA=True

# Where the password-reset throttle keeps its counters in production (a folder every worker process can write to)
CACHE_DIR=

# --- Pricing rules (NPR) -------------------------------------------------------
# Professional: first FREE_PATIENT_LIMIT patients free, then PATIENT_SLOT_RATE per extra patient (bought as slots).
FREE_PATIENT_LIMIT=10
PATIENT_SLOT_RATE=200
# Clinic: new patients per calendar month included, and the NPR charged for each one above it (added as a due).
CLINIC_MONTHLY_PATIENT_CAP=400
CLINIC_OVERAGE_RATE=200

# --- Security -----------------------------------------------------------------
# Put the Django admin on a less guessable address (default admin/)
ADMIN_URL=admin/
# Failed sign-ins allowed before a 15-minute lockout (per username + IP)
LOGIN_FAILURE_LIMIT=5

# --- Subscriptions -----------------------------------------------------------
# Instructions shown to customers on the plan page (where to send the payment)
PAYMENT_INSTRUCTIONS=

# --- Email (optional) -----------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Sajhya Health <no-reply@example.com>

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=
